---
layout: base.njk
---
<section class="hero" aria-labelledby="heading">
  <p class="eyebrow">{{ site.heading | escape }}</p>
  <h1 id="heading">{{ site.title | escape }}</h1>
  <p class="lede">{{ site.intro | escape }}</p>
  <a class="hero-link" href="#articles-heading">Explore the articles <span aria-hidden="true">&darr;</span></a>
</section>
<section class="posts-section" aria-labelledby="articles-heading">
  <div class="section-heading"><h2 id="articles-heading">Latest articles</h2><span>{{ collections.posts.length }} {% if collections.posts.length == 1 %}article{% else %}articles{% endif %}</span></div>
  {% include "article-list.njk" %}
</section>
