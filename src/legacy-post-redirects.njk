---
pagination:
  data: collections.posts
  size: 1
  alias: article
permalink: "/posts/{{ article.fileSlug }}/index.html"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="refresh" content="0; url={{ article.url | escape }}">
    <link rel="canonical" href="{{ article.url | escape }}">
    <title>Article moved</title>
  </head>
  <body>
    <p>This article has moved. <a href="{{ article.url | escape }}">Read it here</a>.</p>
  </body>
</html>
