<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title | escape }} | {% endif %}{{ site.title | escape }}</title>
    <meta name="description" content="{{ (description or site.description) | escape }}">
    <link rel="canonical" href="{{ page.url | url | absoluteUrl(site.url) }}">
    <meta property="og:title" content="{{ (title or site.title) | escape }}">
    <meta property="og:description" content="{{ (description or site.description) | escape }}">
    <meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
    <meta property="og:url" content="{{ page.url | url | absoluteUrl(site.url) }}">
    <link rel="stylesheet" href="/assets/site.css">
    <link rel="alternate" type="application/atom+xml" title="{{ site.title | escape }}" href="/feed.xml">
  </head>
  <body data-palette="{{ site.palette }}" data-font="{{ site.font }}" data-density="{{ site.density }}">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header shell">
      <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">M</span>{{ site.title | escape }}</a>
      <nav aria-label="Main navigation">
        <a href="/about/"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
        <a href="/interviews/"{% if page.url == '/interviews/' %} aria-current="page"{% endif %}>Interviews</a>
        <a href="/articles/"{% if page.url == '/articles/' %} aria-current="page"{% endif %}>Articles</a>
      </nav>
    </header>
    <main id="main" class="shell">{{ content | safe }}</main>
    <footer class="site-footer shell">
      <div class="footer-brand">
        <strong>{{ site.title | escape }}</strong>
        <a href="/feed.xml">RSS / Atom feed</a>
      </div>
      <section aria-labelledby="social-heading">
        <h2 id="social-heading">Social links</h2>
        <ul class="social-links">
          {% for social in site.social_links %}
          <li>
            {% if social.url %}
            <a href="{{ social.url | escape }}">{{ social.label | escape }}{% if social.handle %} <span class="social-handle">{{ social.handle | escape }}</span>{% endif %}</a>
            {% else %}
            <span class="social-placeholder">{{ social.label | escape }}{% if social.handle %} <span class="social-handle">{{ social.handle | escape }}</span>{% endif %} <span class="placeholder-label">Placeholder</span></span>
            {% endif %}
          </li>
          {% else %}
          <li>No social accounts added yet.</li>
          {% endfor %}
        </ul>
      </section>
    </footer>
  </body>
</html>
